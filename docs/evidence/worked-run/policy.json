    "EXAMINER.EXAMINER_NAME",
    "FILER.ADDRESS_LINE1",
    "FILER.DATE_OF_BIRTH",
    "FILER.DISPLAY_NAME",
    "FILER.EMAIL",
    "FILER.PHONE",
    "FILER.TAX_ID",
    "PAYMENT_TXN.ACCOUNT_LAST4"
  ],
  "allow_select_star": false,
  "max_estimated_rows": 5000000,
  "require_row_limit_above_rows": 1000000,
  "require_where_above_rows": 1000000,
  "max_tables_joined": 6,
  "allow_cartesian": false,
  "require_bind_variables": true,
  "allow_hints": false,
  "max_subquery_depth": 4,
  "approval_required_above_rows": 2000000,
  "approval_required_for_sensitivity": "RESTRICTED"
